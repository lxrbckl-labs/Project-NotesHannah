# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Uploaded originals and page images (a bind mount in Docker).
DATA_DIR=./data
# SQLite database file (a named volume in Docker).
DB_PATH=./data/notes.db
# Optional: directory holding the built web app (defaults to apps/web/dist).
# WEB_DIST=
