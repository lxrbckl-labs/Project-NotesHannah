{
  "name": "@notes/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000",
    "e2e": "pnpm --filter @notes/schema build && playwright test && playwright test -c playwright.real.config.ts",
    "e2e:mock": "pnpm --filter @notes/schema build && playwright test",
    "e2e:real": "pnpm --filter @notes/schema build && playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@notes/schema": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
