{
  "name": "@notes/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin": "tsx --env-file-if-exists=../../.env src/cli/admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@node-rs/argon2": "2.2.2",
    "@notes/schema": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "4.23.15"
  },
  "files": [
    "dist"
  ]
}
