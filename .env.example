# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Originals, page images, conversion queue (a bind mount in Docker; the external drive in
# production). Must hold the .notes-storage marker or the server refuses to start; create it
# once with: pnpm --filter @notes/server admin init-storage --create-dir
DATA_DIR=./data/storage
# SQLite database file, kept apart from DATA_DIR (a named volume in Docker).
DB_PATH=./data/notes.db
# Origin the browser uses; state-changing browser requests from any other Origin are refused.
# Required in production, e.g. https://notes.hannahporras.app. Defaults to Vite's dev server.
APP_ORIGIN=http://localhost:5173
# Comma-separated reverse proxies (IPs or CIDR ranges) whose X-Forwarded-For is trusted for
# sign-in rate limits, e.g. the Caddy container's Docker network: 172.16.0.0/12.
# Empty: the socket address is used and X-Forwarded-For is ignored.
TRUSTED_PROXIES=
# Optional: directory holding the built web app (defaults to apps/web/dist).
# WEB_DIST=
