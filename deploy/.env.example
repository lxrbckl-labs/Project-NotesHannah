# Environment for the production stack (deploy/docker-compose.yml and the scripts in scripts/).
# scripts/setup.sh creates deploy/.env from this file and fills in the secrets. Never commit deploy/.env.
#
# Keep values simple: no spaces, quotes or $ signs. The shell scripts and Docker Compose both read this file
# and parse quoting differently, so plain values are the only ones that mean the same thing to both.

# ---- Stack -----------------------------------------------------------------------------------------------------
# Compose project name. The database volume is called "<name>-db". Change it only for a second, separate install.
COMPOSE_PROJECT_NAME=notes

# Image names the compose file builds and runs (scripts/update.sh keeps the previous app image as <name>:previous).
APP_IMAGE=notes-app
CONVERTER_IMAGE=notes-converter

# ---- App -------------------------------------------------------------------------------------------------------
# The exact origin the browser uses (scheme and host, no path, no trailing slash). State-changing browser
# requests from any other Origin are refused.
APP_ORIGIN=https://notes.hannahporras.app

# Host port the app is published on, loopback only (127.0.0.1:<port>). Caddy on the host proxies to it. Use the
# port reserved in docs/mini-handoff.md Task 1.
APP_PORT=3000

# Subnet of the stack's private network. The app sees the host's Caddy as this network's gateway (the .1 address),
# so TRUSTED_PROXIES below names it. Change both together if 10.77.88.0/24 collides with something on the host.
NOTES_SUBNET=10.77.88.0/24

# Reverse proxies whose X-Forwarded-For the app believes (for sign-in rate limits). Caddy runs on the host, so the
# app sees the gateway of NOTES_SUBNET as the peer (measured on Docker Desktop for Mac; on Linux the peer can be
# 127.0.0.1 instead, so both are listed). Only processes on the mini can reach the loopback-only port, so trusting
# these two addresses is safe. Empty would make every visitor share one address for rate limits.
TRUSTED_PROXIES=10.77.88.1,127.0.0.1

# Uid and gid both containers run as. Files on the drive must be readable and writable by it. 10001 is the
# default baked into the images. On Docker Desktop for Mac the value does not matter for the bind mount (see
# docs/deploy.md); on Linux, chown the data directory to it (scripts/setup.sh offers to).
NOTES_UID=10001
NOTES_GID=10001

# Memory limit of the app container.
APP_MEM_LIMIT=1g

# ---- Storage ---------------------------------------------------------------------------------------------------
# Absolute path of the storage directory on the external drive, e.g. /Volumes/NVME1/notes. It must already exist
# (scripts/setup.sh refuses to create it, so an unmounted drive is never replaced by an empty folder on the internal
# disk). Holds originals/, pages/, queue/, tmp/, backups/ and the .notes-storage marker.
DATA_DIR=/Volumes/NVME1/notes

# ---- Converter limits (optional; empty means the built-in default, see docs/converter.md) -----------------------
MAX_INPUT_BYTES=
MAX_PAGES=
WALL_CLOCK_MS=
CHILD_RSS_MB=
POLL_MS=
HEARTBEAT_MS=

# ---- Backups (docs/backups.md) ---------------------------------------------------------------------------------
# Database snapshots are always written to ${DATA_DIR}/backups/db (the data drive).
#
# Second local copy on a DIFFERENT drive: an existing directory carrying a .notes-backup-target marker (setup.sh
# writes it). Receives the database snapshots (db/) and the local restic repository (restic/). Empty: no second copy.
BACKUP_COPY_DIR=/Volumes/NVME2/notes-backups

# Retention ladder for database snapshots (newest snapshot of each bucket is kept).
# How often the backup sidecar (deploy/docker-compose.yml, service backup) snapshots the database, in seconds.
BACKUP_INTERVAL_SECONDS=300
RETAIN_ALL_HOURS=2
RETAIN_HOURLY_HOURS=48
RETAIN_DAILY_DAYS=30
RETAIN_WEEKLY_WEEKS=26
RETAIN_MONTHLY_MONTHS=24

# restic: encrypted, deduplicated copy of originals/ and pages/ (plus each night's database snapshot).
# The local repository lives in ${BACKUP_COPY_DIR}/restic unless RESTIC_REPOSITORY is set.
# Keep RESTIC_PASSWORD ALSO somewhere outside this machine (password manager): without it the repository is lost.
RESTIC_PASSWORD=
RESTIC_REPOSITORY=
# Keep this many restic snapshots (nightly): last N days, weeks, months.
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=26
RESTIC_KEEP_MONTHLY=24

# Optional remote repository (any restic backend). Leave empty to run without one. Nothing remote is required.
#   Backblaze B2:   RESTIC_REMOTE_REPOSITORY=b2:my-bucket:notes
#                   B2_ACCOUNT_ID=...   B2_ACCOUNT_KEY=...
#   Cloudflare R2:  RESTIC_REMOTE_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/my-bucket/notes
#                   AWS_ACCESS_KEY_ID=...   AWS_SECRET_ACCESS_KEY=...   AWS_DEFAULT_REGION=auto
# Password of the remote repository (defaults to RESTIC_PASSWORD when empty).
RESTIC_REMOTE_REPOSITORY=
RESTIC_REMOTE_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# How old (hours) the newest database snapshot and the newest full backup may be before status.sh calls them stale.
STALE_SNAPSHOT_MINUTES=20
STALE_FULL_HOURS=30
