      "native": {
        "kind": "slide",
        "title": "Mechanism of action",
        "text": "Mechanism of action\n\n• Competitive antagonism at beta receptors\n• Lower cAMP in cardiac myocytes\n  – Reduced heart rate and contractility\n  – Reduced renin release\n• Net effect: lower cardiac output and blood pressure",
        "notes": "Draw the cAMP pathway on the board. Stress that antagonism is competitive, so high catecholamine levels can overcome it.",
        "hidden": false,
        "hasUnextractedObjects": false,
        "blocks": [
          {
            "kind": "title",
            "paragraphs": [
              {
                "level": 0,
                "text": "Mechanism of action"
              }
            ]
          },
          {
            "kind": "text",
            "paragraphs": [
              {
                "level": 0,
                "text": "• Competitive antagonism at beta receptors"
              },
              {
                "level": 0,
                "text": "• Lower cAMP in cardiac myocytes"
              },
              {
                "level": 1,
                "text": "– Reduced heart rate and contractility"
              },
              {
                "level": 1,
                "text": "– Reduced renin release"
              },
              {
                "level": 0,
                "text": "• Net effect: lower cardiac output and blood pressure"
              }
            ]
          }
        ]
