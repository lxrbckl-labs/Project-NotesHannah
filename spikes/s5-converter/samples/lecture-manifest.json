      "native": {
        "kind": "slide",
        "title": "Receptor subtypes",
        "text": "Receptor subtypes\n\nReceptor\tMain location\tEffect of stimulation\nbeta-1\tHeart, kidney\tRaises heart rate and contractility\nbeta-2\tBronchi, vascular smooth muscle\tRelaxation, bronchodilation\nbeta-3\tAdipose tissue\tLipolysis",
        "notes": null,
        "hidden": false,
        "hasUnextractedObjects": false,
